<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/step1"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_permissions"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/grant_permissions" />

            <Button
                android:id="@+id/btn_device"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/choose_device" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/step2"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_ime_settings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/open_ime_settings" />

            <Button
                android:id="@+id/btn_ime_pick"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/pick_ime" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/step3"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:id="@+id/state"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <Button
            android:id="@+id/btn_test_record"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_record" />

        <Button
            android:id="@+id/btn_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/play" />

        <Button
            android:id="@+id/btn_test_recognize"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_recognize" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/engine_title" />

        <RadioGroup
            android:id="@+id/engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <RadioButton
                android:id="@+id/engine_android"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/engine_android" />

            <RadioButton
                android:id="@+id/engine_gemini"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/engine_gemini" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/offline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prefer_offline" />

        <LinearLayout
            android:id="@+id/gemini_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <CheckBox
                android:id="@+id/gemini_smart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/gemini_smart" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/gemini_key_title" />

        <EditText
            android:id="@+id/gemini_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="password"
            android:hint="@string/gemini_key_hint"
            android:imeOptions="actionDone"
            android:inputType="textPassword"
            android:singleLine="true" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/step4"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/refine_description" />

        <CheckBox
            android:id="@+id/refine_enabled"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/refine_enabled" />

        <LinearLayout
            android:id="@+id/refine_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_model" />

            <EditText
                android:id="@+id/refine_model"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="text"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_prompt" />

            <EditText
                android:id="@+id/refine_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:maxLines="12"
                android:minLines="4"
                android:scrollbars="vertical"
                android:textSize="13sp" />

            <Button
                android:id="@+id/refine_prompt_reset"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_prompt_reset" />

            <CheckBox
                android:id="@+id/refine_use_context"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_use_context" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_history_count" />

            <EditText
                android:id="@+id/refine_history_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:singleLine="true" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/refine_user_notes" />

            <EditText
                android:id="@+id/refine_user_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="@string/refine_user_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/refine_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/step5"
            android:textAppearance="?android:attr/textAppearanceMedium" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/proofread_description" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:text="@string/proofread_prompt" />

        <EditText
            android:id="@+id/proofread_prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:importantForAutofill="no"
            android:inputType="textMultiLine"
            android:maxLines="12"
            android:minLines="4"
            android:scrollbars="vertical"
            android:textSize="13sp" />

        <Button
            android:id="@+id/proofread_prompt_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/proofread_prompt_reset" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:paddingTop="8dp"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:id="@+id/log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textIsSelectable="true"
            android:typeface="monospace"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
